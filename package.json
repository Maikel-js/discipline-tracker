{
  "name": "discipline-tracker",
  "version": "0.1.0",
  "description": "Discipline Tracker - Habit and Task Management App",
  "author": "Maikel-js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:e2e",
    "electron": "electron .",
    "electron:build": "node scripts/enable-symlinks.mjs && set CSC_IDENTITY_AUTO_DISCOVERY=false&& set DO_NOT_SIGN=true&& npx electron-builder --win --publish never",
    "electron:build:win": "node scripts/enable-symlinks.mjs && set CSC_IDENTITY_AUTO_DISCOVERY=false&& set DO_NOT_SIGN=true&& npx electron-builder --win --publish never",
    "electron:build:linux": "node scripts/enable-symlinks.mjs && set CSC_IDENTITY_AUTO_DISCOVERY=false&& set DO_NOT_SIGN=true&& npx electron-builder --linux --publish never",
    "electron:build:linux:appimage": "node scripts/enable-symlinks.mjs && set CSC_IDENTITY_AUTO_DISCOVERY=false&& set DO_NOT_SIGN=true&& npx electron-builder --linux AppImage --publish never",
    "electron:build:linux:deb": "node scripts/enable-symlinks.mjs && set CSC_IDENTITY_AUTO_DISCOVERY=false&& set DO_NOT_SIGN=true&& npx electron-builder --linux deb --publish never",
    "electron:build:linux:rpm": "node scripts/enable-symlinks.mjs && set CSC_IDENTITY_AUTO_DISCOVERY=false&& set DO_NOT_SIGN=true&& npx electron-builder --linux rpm --publish never",
    "tauri:build:linux": "npx tauri build --target universal-unknown-linux-gnu",
    "tauri:build:linux:deb": "npx tauri build --target x86_64-unknown-linux-gnu --bundles deb",
    "tauri:build:linux:rpm": "npx tauri build --target x86_64-unknown-linux-gnu --bundles rpm",
    "tauri:build:linux:appimage": "npx tauri build --target x86_64-unknown-linux-gnu --bundles appimage",
    "build:linux": "bash scripts/build-linux.sh",
    "upload": "node scripts/upload-exe.mjs",
    "release": "npm run electron:build && npm run upload",
    "deploy": "npm run build && npm run release",
    "deploy:all": "node scripts/deploy-all.mjs",
    "deploy:web": "node scripts/deploy-all.mjs web",
    "deploy:desktop": "node scripts/deploy-all.mjs desktop",
    "deploy:backend": "node scripts/deploy-all.mjs backend",
    "apk": "node scripts/build-apk.mjs",
    "docs:vault": "node scripts/docs-to-vault.mjs",
    "docs:vault:all": "node scripts/docs-to-vault.mjs --all",
    "docs:install-hooks": "node scripts/install-hooks.mjs"
  },
  "build": {
    "appId": "com.discipline.tracker",
    "productName": "Discipline Tracker",
    "compression": "maximum",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "electron/**/*",
      "package.json",
      "!src/**/*",
      "!tests/**/*",
      "!docs/**/*",
      "!node_modules/.cache/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "tar.gz"
      ],
      "category": "Utility",
      "artifactName": "Discipline-Tracker-${version}-Linux.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ],
      "maintainer": "Maikel-js",
      "vendor": "Discipline Tracker",
      "description": "Sistema de seguimiento de hábitos y tareas con IA avanzada"
    },
    "rpm": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "atspi2-core",
        "libuuid",
        "libsecret"
      ],
      "vendor": "Discipline Tracker",
      "description": "Sistema de seguimiento de hábitos y tareas con IA avanzada"
    },
    "portable": {
      "artifactName": "Discipline-Tracker-Setup.exe"
    },
    "mac": false,
    "publish": null
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@capacitor/local-notifications": "^8.1.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@vercel/blob": "^2.3.3",
    "date-fns": "^4.1.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^1.8.0",
    "next": "^16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/cli": "^2.11.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.2.0",
    "electron": "^41.2.2",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.9",
    "typescript": "^5"
  }
}
