# Cloudflare R2 credentials (para subir el .exe)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=discipline-tracker
R2_PUBLIC_URL=

# Frontend (Next.js) — se reemplaza en build time
NEXT_PUBLIC_R2_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
# Rutas de descarga (si R2 está vacío, se sirve desde /public/downloads/)
# NEXT_PUBLIC_R2_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
