{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Discipline Tracker",
  "version": "0.1.0",
  "identifier": "com.discipline.tracker",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Discipline Tracker",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libgtk-3-0",
          "libnotify4",
          "libnss3",
          "libxss1",
          "libxtst6",
          "xdg-utils",
          "libatspi2.0-0",
          "libuuid1",
          "libsecret-1-0"
        ],
        "maintainer": "Maikel-js",
        "vendor": "Discipline Tracker",
        "description": "Sistema de seguimiento de hábitos y tareas con IA avanzada"
      },
      "rpm": {
        "depends": [
          "gtk3",
          "libnotify",
          "nss",
          "libXScrnSaver",
          "libXtst",
          "xdg-utils",
          "atspi2-core",
          "libuuid",
          "libsecret"
        ],
        "vendor": "Discipline Tracker",
        "description": "Sistema de seguimiento de hábitos y tareas con IA avanzada"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
